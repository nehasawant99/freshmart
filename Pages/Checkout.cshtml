@page
@model CheckoutModel

@{
    ViewData["Title"] = "Checkout";
}

<section class="section">

    <div class="container">

        <!-- PAGE HEADER -->

        <div class="page-header">

            <span class="section-label">
                FRESHMART
            </span>

            <h1>
                Checkout
            </h1>

            <p>
                Enter your delivery details to place your order.
            </p>

        </div>


        <div class="checkout-layout">

            <!-- DELIVERY INFORMATION -->

            <div class="checkout-form">

                <h2>
                    Delivery Information
                </h2>


                <form method="post">

                    <!-- Validation / Stock Errors -->

                    <div asp-validation-summary="All"
                         class="validation-summary">
                    </div>


                    <!-- Full Name -->

                    <div class="form-group">

                        <label asp-for="FullName">
                            Full Name
                        </label>

                        <input asp-for="FullName"
                               type="text"
                               placeholder="Enter your full name"
                               required />

                    </div>


                    <!-- Phone Number -->

                    <div class="form-group">

                        <label asp-for="PhoneNumber">
                            Phone Number
                        </label>

                        <input asp-for="PhoneNumber"
                               type="tel"
                               placeholder="Enter your phone number"
                               required />

                    </div>


                    <!-- Address -->

                    <div class="form-group">

                        <label asp-for="Address">
                            Address
                        </label>

                        <textarea asp-for="Address"
                                  placeholder="Enter your delivery address"
                                  rows="4"
                                  required></textarea>

                    </div>


                    <!-- City + Pincode -->

                    <div class="checkout-row">

                        <div class="form-group">

                            <label asp-for="City">
                                City
                            </label>

                            <input asp-for="City"
                                   type="text"
                                   placeholder="Enter city"
                                   required />

                        </div>


                        <div class="form-group">

                            <label asp-for="Pincode">
                                Pincode
                            </label>

                            <input asp-for="Pincode"
                                   type="text"
                                   placeholder="Enter pincode"
                                   required />

                        </div>

                    </div>


                    <!-- Place Order -->

                    <button type="submit"
                            class="checkout-button">

                        Place Order

                    </button>

                </form>

            </div>


            <!-- ORDER SUMMARY -->

            <div class="cart-summary">

                <h2>
                    Order Summary
                </h2>


                <!-- Subtotal -->

                <div class="summary-row">

                    <span>
                        Subtotal
                    </span>

                    <strong>
                        ₹@Model.Subtotal.ToString("0.00")
                    </strong>

                </div>


                <!-- Delivery -->

                <div class="summary-row">

                    <span>
                        Delivery
                    </span>

                    <strong>
                        ₹@Model.DeliveryCharge.ToString("0.00")
                    </strong>

                </div>


                <hr />


                <!-- Total -->

                <div class="summary-total">

                    <span>
                        Total
                    </span>

                    <strong>
                        ₹@Model.Total.ToString("0.00")
                    </strong>

                </div>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

