@page
@model CheckoutModel

@{
    ViewData["Title"] = "Checkout";
}

<section class="section">

    <div class="container">

        <div class="page-header">

            <span class="section-label">
                FRESHMART
            </span>

            <h1>
                Checkout
            </h1>

            <p>
                Enter your delivery details to place your order.
            </p>

        </div>


        <div class="checkout-layout">

            <!-- DELIVERY INFORMATION -->

            <div class="checkout-form">

                <h2>
                    Delivery Information
                </h2>


                <!-- GENERAL VALIDATION ERRORS -->

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <form method="post">

                    <!-- FULL NAME -->

                    <div class="form-group">

                        <label asp-for="FullName">
                            Full Name
                        </label>

                        <input asp-for="FullName"
                               type="text"
                               placeholder="Enter your full name"
                               autocomplete="name" />

                        <span asp-validation-for="FullName"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- PHONE -->

                    <div class="form-group">

                        <label asp-for="PhoneNumber">
                            Phone Number
                        </label>

                        <input asp-for="PhoneNumber"
                               type="tel"
                               placeholder="Enter 10-digit mobile number"
                               maxlength="10"
                               inputmode="numeric"
                               autocomplete="tel" />

                        <span asp-validation-for="PhoneNumber"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- ADDRESS -->

                    <div class="form-group">

                        <label asp-for="Address">
                            Address
                        </label>

                        <textarea asp-for="Address"
                                  placeholder="Enter your delivery address"
                                  rows="4"
                                  autocomplete="street-address"></textarea>

                        <span asp-validation-for="Address"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- CITY + PINCODE -->

                    <div class="checkout-row">

                        <div class="form-group">

                            <label asp-for="City">
                                City
                            </label>

                            <input asp-for="City"
                                   type="text"
                                   placeholder="Enter city"
                                   autocomplete="address-level2" />

                            <span asp-validation-for="City"
                                  class="field-validation">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Pincode">
                                Pincode
                            </label>

                            <input asp-for="Pincode"
                                   type="text"
                                   placeholder="6-digit pincode"
                                   maxlength="6"
                                   inputmode="numeric"
                                   autocomplete="postal-code" />

                            <span asp-validation-for="Pincode"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>


                    <!-- PAYMENT METHOD -->

                    <div class="form-group">

                        <label asp-for="PaymentMethod">
                            Payment Method
                        </label>

                        <select asp-for="PaymentMethod">

                            <option value="">
                                Select payment method
                            </option>

                            <option value="CashOnDelivery">
                                Cash on Delivery
                            </option>

                            <option value="UPI">
                                UPI
                            </option>

                            <option value="Card">
                                Card
                            </option>

                        </select>

                        <span asp-validation-for="PaymentMethod"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- PLACE ORDER -->

                    <button type="submit"
                            class="checkout-button">

                        Place Order

                    </button>

                </form>

            </div>


            <!-- ORDER SUMMARY -->

            <div class="cart-summary">

                <h2>
                    Order Summary
                </h2>


                <div class="summary-row">

                    <span>
                        Subtotal
                    </span>

                    <strong>
                        ₹@Model.Subtotal.ToString("0.00")
                    </strong>

                </div>


                <div class="summary-row">

                    <span>
                        Delivery
                    </span>

                    <strong>
                        ₹@Model.DeliveryCharge.ToString("0.00")
                    </strong>

                </div>


                <hr />


                <div class="summary-total">

                    <span>
                        Total
                    </span>

                    <strong>
                        ₹@Model.Total.ToString("0.00")
                    </strong>

                </div>

            </div>

        </div>

    </div>

</section>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
