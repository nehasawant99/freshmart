@page
@model GroceryShopping.Pages.Admin.Orders.IndexModel

@{
    ViewData["Title"] = "Manage Orders";
}

<section class="section">

    <div class="container">

        <div class="page-header">

            <span class="section-label">
                FRESHMART ADMIN
            </span>

            <h1>
                Manage Orders
            </h1>

            <p>
                View and manage customer orders.
            </p>

        </div>


        <!-- Search and Filter -->

        <form method="get" class="admin-order-filters">

            <div class="admin-filter-group">

                <label for="search">
                    Search Orders
                </label>

                <input type="text"
                       id="search"
                       name="Search"
                       value="@Model.Search"
                       placeholder="Search by order ID or customer..." />

            </div>


            <div class="admin-filter-group">

                <label for="status">
                    Status
                </label>

                <select id="status"
                        name="Status">

                    <option value="">
                        All Statuses
                    </option>

                    <option value="Pending"
                            selected="@(Model.Status == "Pending")">
                        Pending
                    </option>

                    <option value="Confirmed"
                            selected="@(Model.Status == "Confirmed")">
                        Confirmed
                    </option>

                    <option value="OutForDelivery"
                            selected="@(Model.Status == "OutForDelivery")">
                        Out for Delivery
                    </option>

                    <option value="Delivered"
                            selected="@(Model.Status == "Delivered")">
                        Delivered
                    </option>

                    <option value="Cancelled"
                            selected="@(Model.Status == "Cancelled")">
                        Cancelled
                    </option>

                </select>

            </div>


            <button type="submit"
                    class="primary-button admin-filter-button">

                Search

            </button>


            <a asp-page="/Admin/Orders"
               class="secondary-button">

                Clear

            </a>

        </form>


        @if (Model.Orders.Count == 0)
        {
            <div class="admin-empty-state">

                <h3>
                    No orders found
                </h3>

                <p>
                    Try changing your search or filter.
                </p>

            </div>
        }
        else
        {
            <div class="admin-orders-list">

                @foreach (var order in Model.Orders)
                {
                    <div class="admin-order-row">

                        <div class="admin-order-info">

                            <strong>
                                Order #@order.Id
                            </strong>

                            <span>
                                @(order.OrderDate
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt"))
                            </span>

                        </div>


                        <div class="admin-order-total">

                            <strong>
                                ₹@order.Total.ToString("0.00")
                            </strong>

                        </div>


                        <span class="admin-order-status">
                            @(order.Status == "OutForDelivery"
                                ? "Out for Delivery"
                                : order.Status)
                        </span>


                        <a asp-page="/Admin/Orders/Details"
                           asp-route-id="@order.Id"
                           class="admin-view-button">

                            View

                        </a>

                    </div>
                }

            </div>
        }

    </div>

</section>