@page "{id:int}"
@model GroceryShopping.Pages.Admin.Products.EditModel

@{
    ViewData["Title"] = "Edit Product";
}

<section class="section">

    <div class="container">

        <div class="page-header">

            <div>

                <span class="section-label">
                    FRESHMART ADMIN
                </span>

                <h1>Edit Product</h1>

                <p>
                    Update product information.
                </p>

            </div>

        </div>


        <div class="admin-form-container">

            <form method="post">

                <input type="hidden"
                       asp-for="Product.Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>


                <!-- NAME -->

                <div class="form-group">

                    <label asp-for="Product.Name">
                        Product Name
                    </label>

                    <input asp-for="Product.Name"
                           class="form-control" />

                    <span asp-validation-for="Product.Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- DESCRIPTION -->

                <div class="form-group">

                    <label asp-for="Product.Description">
                        Description
                    </label>

                    <textarea asp-for="Product.Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Product.Description"
                          class="text-danger">
                    </span>

                </div>


                <!-- CATEGORY -->

                <div class="form-group">

                    <label asp-for="Product.CategoryId">
                        Category
                    </label>

                    <select asp-for="Product.CategoryId"
                            asp-items="Model.Categories"
                            class="form-control">

                        <option value="">
                            -- Select Category --
                        </option>

                    </select>

                    <span asp-validation-for="Product.CategoryId"
                          class="text-danger">
                    </span>

                </div>


                <!-- PRICE -->

                <div class="form-group">

                    <label asp-for="Product.Price">
                        Price
                    </label>

                    <input asp-for="Product.Price"
                           type="number"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="Product.Price"
                          class="text-danger">
                    </span>

                </div>


                <!-- STOCK -->

                <div class="form-group">

                    <label asp-for="Product.StockQuantity">
                        Stock Quantity
                    </label>

                    <input asp-for="Product.StockQuantity"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="Product.StockQuantity"
                          class="text-danger">
                    </span>

                </div>


                <!-- IMAGE -->

                <div class="form-group">

                    <label asp-for="Product.ImageUrl">
                        Image URL
                    </label>

                    <input asp-for="Product.ImageUrl"
                           class="form-control" />

                    <span asp-validation-for="Product.ImageUrl"
                          class="text-danger">
                    </span>

                </div>


                <!-- AVAILABLE -->

                <div class="form-group checkbox-group">

                    <input asp-for="Product.IsAvailable"
                           type="checkbox" />

                    <label asp-for="Product.IsAvailable">
                        Product is available
                    </label>

                </div>


                <!-- BUTTONS -->

                <div class="form-actions">

                    <button type="submit"
                            class="primary-button">
                        Save Changes
                    </button>

                    <a asp-page="./Index"
                       class="secondary-button">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}