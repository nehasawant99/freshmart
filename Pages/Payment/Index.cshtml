@page "{id:int}"
@model GroceryShopping.Pages.Payment.IndexModel

@{
    ViewData["Title"] = "Payment";
}

<section class="section">

    <div class="container">

        <div class="page-header">

            <span class="section-label">
                FRESHMART
            </span>

            <h1>
                Payment
            </h1>

            <p>
                Complete payment for your order.
            </p>

        </div>


        @if (Model.Order != null && Model.Payment != null)
        {
            <div class="checkout-layout">

                <!-- PAYMENT DETAILS -->

                <div class="checkout-form">

                    <h2>
                        Payment Details
                    </h2>


                    <div class="summary-row">

                        <span>
                            Order
                        </span>

                        <strong>
                            #@Model.Order.Id
                        </strong>

                    </div>


                    <div class="summary-row">

                        <span>
                            Payment Method
                        </span>

                        <strong>
                            @(Model.Payment.PaymentMethod == "CashOnDelivery"
                                ? "Cash on Delivery"
                                : Model.Payment.PaymentMethod)
                        </strong>

                    </div>


                    <div class="summary-row">

                        <span>
                            Amount
                        </span>

                        <strong>
                            ₹@Model.Payment.Amount.ToString("0.00")
                        </strong>

                    </div>


                    <div class="summary-row">

                        <span>
                            Status
                        </span>

                        <strong>
                            @Model.Payment.Status
                        </strong>

                    </div>


                    <!-- PENDING -->

                    @if (Model.Payment.Status == "Pending")
                    {
                        <form method="post"
                              asp-page-handler="Pay"
                              asp-route-id="@Model.Order.Id">

                            <button type="submit"
                                    class="checkout-button">

                                Pay Now

                            </button>

                        </form>


                        <!-- Development testing only -->

                        <form method="post"
                              asp-page-handler="Fail"
                              asp-route-id="@Model.Order.Id"
                              style="margin-top: 10px;">

                            <button type="submit"
                                    class="secondary-button">

                                Simulate Payment Failure

                            </button>

                        </form>
                    }


                    <!-- FAILED -->

                    @if (Model.Payment.Status == "Failed")
                    {
                        <div class="validation-summary">

                            Payment failed. Your order is still pending.
                            You can retry the payment.

                        </div>


                        <form method="post"
                              asp-page-handler="Pay"
                              asp-route-id="@Model.Order.Id">

                            <button type="submit"
                                    class="checkout-button">

                                Retry Payment

                            </button>

                        </form>
                    }


                    <!-- PAID -->

                    @if (Model.Payment.Status == "Paid")
                    {
                        <div class="validation-summary">

                            Payment completed successfully.

                        </div>


                        <a asp-page="/OrderConfirmation"
                           asp-route-id="@Model.Order.Id"
                           class="primary-button">

                            View Order Confirmation

                        </a>
                    }

                </div>


                <!-- ORDER SUMMARY -->

                <div class="cart-summary">

                    <h2>
                        Order Summary
                    </h2>


                    <div class="summary-row">

                        <span>
                            Order Total
                        </span>

                        <strong>
                            ₹@Model.Order.Total.ToString("0.00")
                        </strong>

                    </div>

                </div>

            </div>
        }

    </div>

</section>

